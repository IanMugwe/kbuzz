---
import {Image} from 'astro:assets'
import acousticSessionImg from '../../assets/img/acoustic-session.jpg'
import leatherTanneryImg from '../../assets/img/leather-tannery.jpg'
import streetFoodImg from '../../assets/img/street-food.jpg'
import townHallImg from '../../assets/img/town-hall.jpg'
---
<!-- 7. KIAMAIKO FM VIDEO (DIGITAL MEDIA GRID / INK) -->
<section class="kb-ink kb-section kb-section--torn" id="studio" style="--tear-top:#e8e3da; --tear-bottom:#efebe4">
<div aria-hidden="true" class="kb-tear kb-tear--top"></div>
<div class="kb-wrap">
<div class="kb-head kb-rise">
<div>
<span class="kb-kicker"><span class="material-symbols-outlined text-base">videocam</span>FIELD RECORDINGS • CINEMA DISPATCHES</span>
<h2 class="kb-head__title">
<span class="kb-display">Kiamaiko TV</span>
<span class="kb-script">Visual<br/>Journalism<svg aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 200 20"><path d="M4 16 C 60 8, 130 4, 196 3" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="6"></path></svg></span>
</h2>
</div>
<div class="kb-meta text-stone-300 flex items-center gap-2">
<span class="w-2 h-2 rounded-full bg-red-600 animate-ping"></span>
<span>Broadcasting in 4K UHD</span>
</div>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
<!-- Main Featured Video (Spans 8 cols) -->
<div class="lg:col-span-8 group cursor-pointer kb-rise" style="--c:#e11d2a">
<div class="kb-media aspect-video">
<Image alt="" class="opacity-85" data-alt="Cinematic wide 16:9 documentary still inside a historic artisan leather tannery in Kiamaiko Nairobi. High contrast lighting with atmospheric smoke shafts of afternoon sun illuminating skilled older craftsmen stretching and treating hide. Editorial color palette dominated by warm ochres rich deep blacks and subtle crimson tones." src={leatherTanneryImg} format="webp" quality={72}/>
<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/10 to-black/30"></div>
<!-- Play Trigger -->
<span class="kb-play"><span class="material-symbols-outlined text-4xl">play_arrow</span></span>
<div class="absolute top-4 left-4 kb-meta text-white bg-black/60 backdrop-blur px-3 py-1.5">
              DOCUSERIES EPISODE 01
            </div>
<div class="absolute bottom-4 right-4 kb-meta text-stone-200 bg-black/60 backdrop-blur px-2.5 py-1">
              14:20 MIN
            </div>
</div>
<div class="mt-6">
<span class="kb-meta text-[#10b981]">Featured Documentary</span>
<h3 class="kb-title kb-title--light text-[2.1rem] mt-2">
              Voices from the Tannery Quarter: Fifty Years of Craft and Community
            </h3>
<p class="kb-body kb-body--light mt-3 max-w-3xl">
              An immersive 15-minute investigation chronicling three generations of leather tanners navigating urban gentrification, water purification advocacy, and the global preservation of heritage techniques.
            </p>
</div>
</div>
<!-- Secondary Video Column (Spans 4 cols) -->
<div class="lg:col-span-4 flex flex-col kb-rise" style="--d:.1s">
<div class="kb-meta text-stone-400 pb-3 mb-2 border-b border-white/10">
            Recent Episodes &amp; Broadcast Tapes
          </div>
<!-- Episode 1 -->
<div class="kb-episode group" style="--c:#e11d2a">
<div class="kb-media kb-episode__thumb">
<Image alt="" data-alt="Documentary video thumbnail showing vibrant Eastlands Nairobi night street food stalls with sizzling skewers of meat and steaming broth pots under bright warm light bulbs. High contrast authentic urban nightlife photo." src={streetFoodImg} format="webp" quality={72}/>
<span class="kb-episode__time">08:45</span>
</div>
<div>
<span class="kb-meta kb-meta--accent">Street Food Tour</span>
<h4 class="kb-title kb-title--light text-[1.2rem] mt-1 line-clamp-2">
                Searching for the Best Ugali &amp; Goat Broth in Eastlands
              </h4>
<p class="kb-meta text-stone-500 mt-1">3.2k Views • 2 days ago</p>
</div>
</div>
<!-- Episode 2 -->
<div class="kb-episode group" style="--c:#10b981">
<div class="kb-media kb-episode__thumb">
<Image alt="" data-alt="Intimate acoustic recording session thumbnail inside a radio studio showing a talented female East African singer singing passionately into a large studio condenser microphone under dramatic warm spotlighting." src={acousticSessionImg} format="webp" quality={72}/>
<span class="kb-episode__time">11:12</span>
</div>
<div>
<span class="kb-meta kb-meta--accent">Studio Sessions #4</span>
<h4 class="kb-title kb-title--light text-[1.2rem] mt-1 line-clamp-2">
                Live Acoustic Performance with Njoki Karu
              </h4>
<p class="kb-meta text-stone-500 mt-1">6.8k Views • 5 days ago</p>
</div>
</div>
<!-- Episode 3 -->
<div class="kb-episode group" style="--c:#f5b400">
<div class="kb-media kb-episode__thumb">
<Image alt="" data-alt="Investigative journalism video thumbnail featuring a neighborhood town hall meeting in Nairobi with citizens addressing city infrastructure engineers over paper blueprints. High-contrast authentic editorial lighting." src={townHallImg} format="webp" quality={72}/>
<span class="kb-episode__time">06:30</span>
</div>
<div>
<span class="kb-meta kb-meta--accent">Civic Watch</span>
<h4 class="kb-title kb-title--light text-[1.2rem] mt-1 line-clamp-2">
                Roads, Clean Water &amp; Infrastructure Audit 2024
              </h4>
<p class="kb-meta text-stone-500 mt-1">1.9k Views • 1 week ago</p>
</div>
</div>
</div>
</div>
</div>
<div aria-hidden="true" class="kb-tear kb-tear--bottom"></div>
</section>
