---
import {Image} from 'astro:assets'
import aminaHassanImg from '../../assets/img/amina-hassan.jpg'
import cultureImg from '../../assets/img/culture.jpg'
import karanjaSculptorImg from '../../assets/img/karanja-sculptor.jpg'
import leatherTanneryImg from '../../assets/img/leather-tannery.jpg'
---
<section class="relative bg-[#0d0d0f] text-white overflow-hidden">
<!-- 3. OUR PILLARS / THE STORIES THAT MOVE US (Paper Canvas) -->
<div class="kb-pillars text-on-surface py-16 lg:py-20 px-6 lg:px-12" id="pillars">
<div class="max-w-[1440px] mx-auto relative">
<!-- Section Header -->
<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-12 lg:mb-14">
<div>
<span class="font-label-sm text-xs font-bold uppercase tracking-[0.18em] text-[#e11d2a] block mb-3">OUR PILLARS</span>
<h2 class="flex items-end flex-wrap gap-x-8 gap-y-2">
<span class="kb-pillars__title">The Stories</span>
<span class="kb-pillars__script">That<br/>Move Us<svg aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 200 20"><path d="M4 16 C 60 8, 130 4, 196 3" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="6"></path></svg></span>
</h2>
</div>
<div class="flex items-center gap-10 lg:gap-24 lg:pb-3">
<p class="font-body-md text-sm text-stone-800 leading-relaxed max-w-[17rem]">
            From the streets to the studios, from the classroom to the boardroom — we tell the stories that shape our world.
          </p>
<a aria-label="Explore all pillars" class="kb-pillars__arrow text-black" href="#culture">
<span class="material-symbols-outlined text-3xl">arrow_forward</span>
</a>
</div>
</div>
<!-- 4-Column Pillar Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
<!-- 01 CULTURE -->
<a class="kb-pillar group" href="#culture" style="--c:#e11d2a">
<div class="kb-pillar__media">
<Image alt="Culture" loading="lazy" src={cultureImg} format="webp" quality={72}/>
<svg aria-hidden="true" class="kb-pillar__wave" viewBox="0 0 94 50"><path d="M2 30 L12 12 L18 40 L26 6 L33 44 L40 14 L47 36 L54 10 L61 42 L68 18 L76 34 L84 22 L92 30" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="4"></path></svg>
</div>
<div class="kb-pillar__num">01</div>
<h3 class="kb-pillar__name">Culture</h3>
<p class="font-body-sm text-[13px] text-stone-700 mt-3 leading-relaxed max-w-[15rem]">Music, art, fashion, food, traditions and the places that define us.</p>
<span class="kb-pillar__cta">
<span>EXPLORE</span>
<span class="material-symbols-outlined text-lg">arrow_forward</span>
</span>
</a>
<!-- 02 PEOPLE -->
<a class="kb-pillar group" href="#people" style="--c:#0f8a5f">
<div class="kb-pillar__media">
<Image alt="People" loading="lazy" src={karanjaSculptorImg} format="webp" quality={72}/>
<svg aria-hidden="true" class="kb-pillar__wave" viewBox="0 0 94 50"><path d="M2 30 L10 26 L16 34 L22 16 L29 42 L35 20 L41 36 L47 12 L53 44 L59 22 L66 34 L74 26 L92 30" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="4"></path></svg>
</div>
<div class="kb-pillar__num">02</div>
<h3 class="kb-pillar__name">People</h3>
<p class="font-body-sm text-[13px] text-stone-700 mt-3 leading-relaxed max-w-[15rem]">Profiles, interviews and real stories from everyday changemakers.</p>
<span class="kb-pillar__cta">
<span>EXPLORE</span>
<span class="material-symbols-outlined text-lg">arrow_forward</span>
</span>
</a>
<!-- 03 YOUTH -->
<a class="kb-pillar group" href="#youth" style="--c:#e0a100">
<div class="kb-pillar__media">
<Image alt="Youth" loading="lazy" src={aminaHassanImg} format="webp" quality={72}/>
<svg aria-hidden="true" class="kb-pillar__wave" viewBox="0 0 94 50"><path d="M2 30 L9 24 L15 36 L21 20 L27 40 L33 18 L39 38 L45 22 L51 36 L58 26 L66 32 L78 28 L92 30" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="4"></path></svg>
</div>
<div class="kb-pillar__num">03</div>
<h3 class="kb-pillar__name">Youth</h3>
<p class="font-body-sm text-[13px] text-stone-700 mt-3 leading-relaxed max-w-[15rem]">The dreams, struggles and bold ideas of a new generation.</p>
<span class="kb-pillar__cta">
<span>EXPLORE</span>
<span class="material-symbols-outlined text-lg">arrow_forward</span>
</span>
</a>
<!-- 04 IDEAS -->
<a class="kb-pillar group" href="#ideas" style="--c:#0f8a5f">
<div class="kb-pillar__media">
<Image alt="Ideas" loading="lazy" src={leatherTanneryImg} format="webp" quality={72}/>
<svg aria-hidden="true" class="kb-pillar__wave" viewBox="0 0 94 50"><path d="M2 30 L10 22 L16 38 L23 14 L30 42 L37 18 L44 38 L51 24 L58 34 L66 28 L76 31 L92 30" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="4"></path></svg>
</div>
<div class="kb-pillar__num">04</div>
<h3 class="kb-pillar__name">Ideas</h3>
<p class="font-body-sm text-[13px] text-stone-700 mt-3 leading-relaxed max-w-[15rem]">Thoughts worth questioning, conversations that matter, ideas for what's next.</p>
<span class="kb-pillar__cta">
<span>EXPLORE</span>
<span class="material-symbols-outlined text-lg">arrow_forward</span>
</span>
</a>
</div>
</div>
</div>
</section>
