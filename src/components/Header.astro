---
// Transparent over the homepage hero; solid everywhere else.
interface Props { solid?: boolean }
const { solid = false } = Astro.props
---
<header class:list={["w-full sticky top-0 z-50 border-b text-white", {"is-scrolled": solid}]} id="site-header">
<div class="max-w-[1440px] mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">
<div class="flex items-center gap-4">
<a class="flex items-baseline gap-2 group select-none" href="/">
<span class="kb-logo text-white group-hover:text-primary transition-colors">
          DIGITAL DIGEST
        </span>
<span class="font-label-sm text-[11px] text-primary tracking-widest uppercase font-semibold hidden sm:inline-block border-l border-stone-700 pl-2">
          KIAMAIKO FM
        </span>
</a>
</div>
<nav class="hidden md:flex items-center space-x-8 font-label-md text-sm tracking-wider uppercase">
<a class:list={[solid ? "text-stone-300 hover:text-white transition-colors" : "text-white border-b-2 border-primary pb-1 font-semibold"]} href="/">Home</a>
<a class="text-stone-300 hover:text-white transition-colors" href="/#culture">Culture</a>
<a class="text-stone-300 hover:text-white transition-colors" href="/#people">People</a>
<a class="text-stone-300 hover:text-white transition-colors" href="/#youth">Youth</a>
<a class="text-stone-300 hover:text-white transition-colors" href="/#ideas">Ideas</a>
<a class="text-stone-300 hover:text-primary-fixed transition-colors flex items-center gap-1.5" href="/#radio">
<span class="w-2 h-2 rounded-full bg-red-600 animate-ping"></span>
        Radio 98.4
      </a>
</nav>
<div class="flex items-center gap-4">
<button aria-label="Search" class="w-10 h-10 rounded-full hover:bg-stone-800 flex items-center justify-center text-stone-200 transition-colors">
<span class="material-symbols-outlined text-xl">search</span>
</button>
<button aria-label="Menu" class="w-10 h-10 rounded-full hover:bg-stone-800 flex items-center justify-center text-stone-200 transition-colors">
<span class="material-symbols-outlined text-2xl">menu</span>
</button>
</div>
</div>
</header>
