---
import {antonUrl} from '../styles/fonts'
import '../styles/icons.css'
import '../styles/kbuzz.css'
import '../styles/story.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import {SITE_DESCRIPTION, SITE_NAME, SITE_URL} from '../lib/site'

interface Props {
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  solidHeader?: boolean
  publishedAt?: string
  noindex?: boolean
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = `${SITE_URL}/assets/img/og-cover.jpg`,
  type = 'website',
  solidHeader = true,
  publishedAt,
  noindex = false,
} = Astro.props
const pageTitle = title ? `${title} — ${SITE_NAME}` : 'KIAMAIKO FM — Voice & Pulse of the Community (98.4 FM)'
const canonical = new URL(Astro.url.pathname, SITE_URL).href
---
<!DOCTYPE html>
<html class="light" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>{pageTitle}</title>
<meta content={description} name="description"/>
<meta content="#b70011" name="theme-color"/>
<link href="/favicon.svg" rel="icon" type="image/svg+xml"/>
<link href={canonical} rel="canonical"/>
<link href="/rss.xml" rel="alternate" title="K Buzz stories" type="application/rss+xml"/>
{noindex && <meta content="noindex" name="robots"/>}
<!-- Social sharing (WhatsApp, X, Facebook) -->
<meta content={type} property="og:type"/>
<meta content={SITE_NAME} property="og:site_name"/>
<meta content={title ?? 'KIAMAIKO FM — Voice & Pulse of the Community'} property="og:title"/>
<meta content={description} property="og:description"/>
<meta content={image} property="og:image"/>
<meta content={canonical} property="og:url"/>
{publishedAt && <meta content={publishedAt} property="article:published_time"/>}
<meta content="summary_large_image" name="twitter:card"/>
<slot name="head"/>
<!-- Fonts are self-hosted (src/styles/fonts.ts, src/styles/icons.css); preload the headline face (the icon subset is inlined into the CSS). -->
<link as="font" crossorigin="" href={antonUrl} rel="preload" type="font/woff2"/>
<link href="https://cdn.sanity.io" rel="preconnect"/>
</head>
<body class="bg-[#FAF8F5] text-on-surface font-body-md text-body-md antialiased selection:bg-primary-container selection:text-white">
<Header solid={solidHeader}/>
<slot/>
<Footer/>
<slot name="scripts"/>
<script is:inline src="/scripts/reveal.js"></script>
</body>
</html>
