---
import Base from '../layouts/Base.astro'
import PageHead from '../components/PageHead.astro'
---
<Base noindex title="Page not found">
<main class="kb-paper kb-section">
<div class="kb-wrap">
<PageHead description="That page has moved or never existed. The latest dispatches are a click away." kicker="404" script="Pole sana" title="Lost the signal"/>
<div class="flex flex-wrap gap-3">
<a class="kb-pill kb-pill--solid" href="/">Back to the homepage</a>
<a class="kb-pill" href="/stories">All stories</a>
</div>
</div>
</main>
</Base>
